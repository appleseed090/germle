// Cloudflare Workers static assets plus a small Worker for the community score API.
// The Worker name must match the project name chosen in the Cloudflare dashboard.
{
  "name": "germle",
  // Handles /api/* only; see run_worker_first below.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Lets the Worker hand any non-API request that reaches it back to the static assets.
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; every other path is served from dist/ as before.
    "run_worker_first": ["/api/*"],
    // /about serves about.html; /about.html redirects to /about.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get a plain 404 rather than the game page.
    "not_found_handling": "none",
  },
  // Community scores (migrations/): the production database, created 2026-10-08 (DEPLOY.md
  // step 7). Previews never get this binding; see "previews" below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "germle",
      "database_id": "80b7e28e-0581-4ac1-ba16-874e9c3fc441",
      "migrations_dir": "migrations",
    },
  ],
  // Workers Builds runs `npx wrangler preview` for every non-main branch, which refuses to run
  // without this block. Bindings are not inherited by previews, so previews get no DB binding
  // and the API answers 503 there: preview deployments never touch the production database.
  "previews": {},
}
